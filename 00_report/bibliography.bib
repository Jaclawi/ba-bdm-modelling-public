  author = {K{\"u}lling, Nathan and Adde, Antoine and Fopp, Fabian and Schweiger, Anna K. and Broennimann, Olivier and Rey, Pierre-Louis and Giuliani, Gregory and Goicolea, Teresa and Petitpierre, Blaise and Zimmermann, Niklaus E. and Pellissier, Lo{\"i}c and Altermatt, Florian and Lehmann, Anthony and Guisan, Antoine},
