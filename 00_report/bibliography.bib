  author = {Midolo, Gabriele and Clark, Adam Thomas and Chytr{\'y}, Milan and Essl, Franz and Dullinger, Stefan and Jandt, Ute and Bruelheide, Helge and Argagnon, Olivier and Biurrun, Idoia and Chiarucci, Alessandro and {\'C}u{\v s}terevska, Renata and De Frenne, Pieter and De Sanctis, Michele and Dengler, J{\"u}rgen and Div{\'i}{\v s}ek, Jan and Dziuba, Tetiana and Ejrn{\ae}s, Rasmus and Garbolino, Emmanuel and Illa, Estela and Jentsch, Anke and Jim{\'e}nez-Alfaro, Borja and Lenoir, Jonathan and Moeslund, Jesper Erenskjold and Napoleone, Francesca and Pielech, Remigiusz and Rumpf, Sabine B. and Sanz-Zubizarreta, Irati and Silva, Vasco and Svenning, Jens-Christian and Swacha, Grzegorz and Ve{\v c}e{\v r}a, Martin and Vynokurov, Denys and Keil, Petr},
